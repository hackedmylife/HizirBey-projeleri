{
  "manifest_version": 3,
  "name": "Hızır Bey Sohbet Asistanı",
  "version": "0.3.3",
  "minimum_chrome_version": "116",
  "description": "LiveChat için FastKeys bilgisiyle profesyonel yanıtlar ve otomatik yapay zekâ geçişi. Yalnızca önerir ve kopyalar.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Asistan ayarları"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://my.livechatinc.com/*",
        "https://my.livechat.com/*"
      ],
      "js": [
        "reader.js",
        "capture.js",
        "dock.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png"
      ],
      "matches": [
        "https://my.livechatinc.com/*",
        "https://my.livechat.com/*"
      ]
    }
  ]
}
